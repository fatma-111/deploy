# ---------------------------------------------------------------------------
# BugHound configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- LLM (FREE / REQUIRED for model-backed runs) ---------------------------
# Default provider: OpenRouter. Get a key at https://openrouter.ai/keys
# Browse currently free models at https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=

# --- Using OpenAI (or any OpenAI-compatible endpoint) instead --------------
# Leave these blank for OpenRouter. When set, they override OPENROUTER_API_KEY
# and OPENROUTER_BASE_URL, and free-model discovery switches itself off.
#
#   OpenAI directly (PAID - no free tier):
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_API_KEY=sk-...
#     OPENROUTER_MODEL=gpt-5.6-luna
#     OPENROUTER_FALLBACK_MODELS=gpt-5.6-terra
#
#   An OpenAI model, still free, through OpenRouter (recommended):
#     OPENROUTER_MODEL=openai/gpt-oss-120b:free
#
#   Local Ollama / LM Studio / vLLM:
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
# Verified free on 2026-08-13. Free IDs rotate constantly - if one 404s, the app
# discovers live replacements automatically (see MODEL_DISCOVERY_ENABLED below),
# and GET /api/models/free shows what is available right now.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free

# Ask OpenRouter's public catalog for currently free models and append them to
# the fallback chain. Set to false to use only the IDs listed above.
MODEL_DISCOVERY_ENABLED=true
# Optional cheaper model for the Debug and Research agents. Blank = use the primary.
OPENROUTER_FAST_MODEL=

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# --- Orchestration ---------------------------------------------------------
# Which multi-agent engine runs the investigation:
#   langgraph  default. No extra dependencies, works without an API key.
#   crewai     classic Crews (Agents + Tasks). Needs:
#                pip install -r requirements-crewai.txt
#              and a configured model. Falls back to langgraph if either is missing.
ORCHESTRATOR=langgraph
CONFIDENCE_THRESHOLD=0.80
MAX_RESEARCH_ITERATIONS=2
MAX_FIX_RETRIES=2

# --- Research tools (FREE / OPTIONAL) --------------------------------------
# GitHub works anonymously at 60 req/hour. A token raises it to 5000.
GITHUB_TOKEN=
WEB_SEARCH_ENABLED=true
TOOL_TIMEOUT_SECONDS=15
MAX_SEARCH_RESULTS=6

# --- Knowledge base / RAG (FREE / OPTIONAL) --------------------------------
# Repeated errors are answered from data/error_knowledge_base.pdf (extracted to
# knowledge_base_seed.json) instead of calling a model. Nothing here needs a key.
KB_ENABLED=true
KB_MATCH_THRESHOLD=0.55
KB_LEARNING_ENABLED=true
KB_LEARN_MIN_CONFIDENCE=0.80
KB_MAX_LEARNED_ENTRIES=500

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=*
# Force heuristic mode even when a key is present (useful for offline demos).
DEMO_MODE=false

# --- Streamlit UI ----------------------------------------------------------
BUGHOUND_API_URL=http://localhost:8000


N8N_WEBHOOK_ENABLED=true
N8N_WEBHOOK_URL=https://fatmasharaf11.app.n8n.cloud/webhook/bughound-report
